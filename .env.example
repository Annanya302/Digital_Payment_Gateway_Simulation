# ==============================================================================
# DIGITAL PAYMENT GATEWAY SIMULATION - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env in backend/ or root for custom deployment settings
# ==============================================================================

# Backend Server Port
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=super-secret-jwt-key-for-simulation-gateway-2026
JWT_EXPIRES_IN=24h

# Frontend CORS Origin
CORS_ORIGIN=http://localhost:3000

# Next.js Public API Base URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Supabase PostgreSQL Configuration (Optional - Backend runs out-of-the-box in local memory mode if empty)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Simulation Settings
DEFAULT_WALLET_BALANCE=10000.00
MAX_SINGLE_TRANSACTION_LIMIT=25000.00
MAX_DAILY_TRANSACTION_LIMIT=50000.00
